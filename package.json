{
  "name": "pixelforge",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.6.5",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r test:watch",
    "bench": "pnpm -r --workspace-concurrency=1 bench",
    "typecheck": "pnpm -r typecheck",
    "check-bench": "pnpm run check-bench:core && pnpm run check-bench:editor",
    "check-bench:core": "node --experimental-strip-types scripts/check-bench.ts bench/core-results.json packages/core/bench/thresholds.json",
    "check-bench:editor": "node --experimental-strip-types scripts/check-bench.ts bench/results.json apps/editor/bench/thresholds.json",
    "changeset": "changeset",
    "changeset:version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "typescript": "^5"
  }
}
